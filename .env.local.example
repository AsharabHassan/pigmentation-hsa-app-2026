# ── Server (never exposed to the browser) ───────────────────────────────────
# Anthropic API key for the Claude Vision pigmentation analysis.
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (defaults to claude-sonnet-4-6).
ANTHROPIC_MODEL=claude-sonnet-5-5
# GoHighLevel inbound webhook URL that receives qualified leads (contact details
# + written result summary).
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/...
# The clinic's own CRM inbound webhooks (GoHighLevel cutover, 20 Nov 2026).
# A London lead goes to CRM_WEBHOOK_URL_LONDON and a Glasgow lead to
# CRM_WEBHOOK_URL_GLASGOW, INSTEAD of GHL_WEBHOOK_URL, with the same payload.
# A clinic whose variable is unset or blank keeps using GHL_WEBHOOK_URL.
# Must be https.
CRM_WEBHOOK_URL_LONDON=
CRM_WEBHOOK_URL_GLASGOW=
# Older extra copy of every lead to the CRM (set in Vercel production today).
# Sent in addition to the target above unless it is the same address. Remove it
# (or set it equal to the clinic's CRM webhook) after the cutover, otherwise the
# CRM receives each lead twice.
# CRM_LEAD_WEBHOOK_URL=
# The clinic CRM's API (Harley Street Aesthetics sub-account). When
# CRM_API_KEY is set it REPLACES the GHL Private Integration below: every lead
# is upserted with its tags and answers in custom fields (lib/crm-fields.ts),
# and the report PDF is kept on the contact with a private patient link that is
# written to facial_app_report_pdf, noted and emailed from the CRM. The key
# needs contacts.write, files.write and conversations.send. CRM_API_BASE is
# optional (default https://app.crm.strategyguys.agency/api/v1 — keep the main
# address: clinic domains cap uploads at 5 MB); CRM_ACCOUNT defaults to
# harley-street-aesthetic.
CRM_API_KEY=
# CRM_API_BASE=https://app.crm.strategyguys.agency/api/v1
# CRM_ACCOUNT=harley-street-aesthetic
# GHL Private Integration — used for report delivery while CRM_API_KEY is unset. With these
# set, every completed analysis uploads the report PDF, writes its URL onto the
# contact and emails the patient their copy. Leave them unset and the app skips
# report delivery silently; the lead webhook above still fires.
GHL_API_TOKEN=REPLACE
GHL_LOCATION_ID=REPLACE
GHL_REPORT_FIELD_KEY=facial_app_report_pdf

# ── Insights database (optional — see docker/ and the README) ───────────────
# Self-hosted Docker Postgres. Every analysis, lead, result-page click and GHL
# booking is recorded here; no photo is ever stored. Unset = nothing recorded.
DATABASE_URL=postgres://hsa:PASSWORD@YOUR-VPS-HOST:5432/hsa_insights?sslmode=require
# Shared secret the GoHighLevel booking workflow sends as the x-hsa-secret header.
BOOKING_WEBHOOK_SECRET=REPLACE-with-a-long-random-string
# Password for /admin (any username). Minimum 12 characters or /admin stays locked.
ADMIN_PASSWORD=REPLACE-with-a-long-random-string

# ── Public (safe to expose) ─────────────────────────────────────────────────
# Booking / "Book Your Free Online Consultation" destinations.
NEXT_PUBLIC_BOOKING_URL=https://harleystreetaesthetic.co.uk/london/contact/
NEXT_PUBLIC_GLASGOW_BOOKING_URL=https://harleystreetaesthetic.co.uk/glasgow/contact/
# The consultation calendar is the CRM booking page, fixed in lib/constants.ts
# (CRM_BOOKING_URL, app.harleystreetaesthetic.co.uk), embedded on the result
# page; no contact prefill. NEXT_PUBLIC_BOOKING_CALENDAR_URL and
# NEXT_PUBLIC_GLASGOW_BOOKING_CALENDAR_URL are no longer read.
NEXT_PUBLIC_SITE_URL=https://pigmentation.harleystreetaesthetic.co.uk
# Meta dataset/pixel used by the HSA pigmentation campaign.
NEXT_PUBLIC_META_PIXEL_ID=1849043682301992

# Optional: HSA SkinScan service URL. Unset = Claude-only analysis.
SKINSCAN_URL=

# AI "after" preview (OpenAI GPT-Image-2.5). Optional — without it the on-device preview is used.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=high
